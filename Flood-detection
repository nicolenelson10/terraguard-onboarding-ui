        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                "outline-variant": "#3c4a45",
                "surface-container-highest": "#2a344d",
                "on-tertiary-fixed-variant": "#374767",
                "surface-variant": "#2a344d",
                "primary": "#ffffff",
                "on-tertiary": "#20304f",
                "on-primary": "#00382d",
                "surface-container-high": "#1f2942",
                "on-error-container": "#ffdad6",
                "on-secondary-container": "#abb9d6",
                "primary-fixed-dim": "#38debb",
                "on-secondary-fixed-variant": "#39475f",
                "on-secondary-fixed": "#0d1c32",
                "on-background": "#d9e2ff",
                "on-surface": "#d9e2ff",
                "surface-container-low": "#101b33",
                "surface-container": "#151f37",
                "on-secondary": "#233148",
                "on-primary-fixed": "#002019",
                "background": "#08132a",
                "tertiary": "#ffffff",
                "on-tertiary-container": "#556486",
                "inverse-on-surface": "#263049",
                "secondary": "#b9c7e4",
                "error-container": "#93000a",
                "primary-container": "#5ffbd6",
                "on-surface-variant": "#bacac3",
                "secondary-fixed": "#d6e3ff",
                "inverse-surface": "#d9e2ff",
                "tertiary-container": "#d8e2ff",
                "secondary-container": "#3c4962",
                "tertiary-fixed": "#d8e2ff",
                "on-tertiary-fixed": "#091b39",
                "outline": "#85948e",
                "surface-bright": "#2f3952",
                "surface-dim": "#08132a",
                "surface-tint": "#38debb",
                "tertiary-fixed-dim": "#b6c6ed",
                "on-primary-fixed-variant": "#005142",
                "error": "#ffb4ab",
                "secondary-fixed-dim": "#b9c7e4",
                "inverse-primary": "#006b58",
                "on-primary-container": "#00725e",
                "surface": "#08132a",
                "primary-fixed": "#5ffbd6",
                "on-error": "#690005",
                "surface-container-lowest": "#030d25"
            },
            "borderRadius": {
                "DEFAULT": "0.25rem",
                "lg": "0.5rem",
                "xl": "0.75rem",
                "full": "9999px"
            },
            "spacing": {
                "element-gap": "12px",
                "container-padding": "20px",
                "stack-gap": "16px",
                "safe-area-bottom": "34px",
                "unit": "4px"
            },
            "fontFamily": {
                "headline-sm": ["Inter"],
                "body-sm": ["Inter"],
                "label-caps": ["JetBrains Mono"],
                "body-lg": ["Inter"],
                "headline-md": ["Inter"],
                "display-lg": ["Inter"],
                "data-mono": ["JetBrains Mono"]
            },
            "fontSize": {
                "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                "body-sm": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.1em", "fontWeight": "500"}],
                "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                "headline-md": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                "display-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                "data-mono": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        body {
            background-color: #08132a;
            color: #d9e2ff;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .glass-card {
            background: rgba(17, 34, 64, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(100, 255, 218, 0.1);
        }

        .cyan-glow {
            box-shadow: 0 0 15px 0px rgba(56, 222, 187, 0.3);
        }

        .accent-gradient {
            background: linear-gradient(135deg, #38debb 0%, #00725e 100%);
        }

        .scanning-line {
            position: absolute;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #38debb, transparent);
            top: 0;
            animation: scan 3s ease-in-out infinite;
        }

        @keyframes scan {
            0% { top: 20%; opacity: 0; }
            50% { opacity: 1; }
            100% { top: 80%; opacity: 0; }
        }

        .parallax-target {
            transition: transform 0.1s ease-out;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">
<!-- Top App Bar (Shared Component) -->
<header class="fixed top-0 w-full z-50 flex items-center justify-center px-container-padding py-4 w-full bg-transparent">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">satellite_alt</span>
<h1 class="font-headline-md-mobile text-headline-md-mobile tracking-widest text-primary uppercase font-bold">TERRAGUARD</h1>
</div>
</header>
<!-- Main Content: Onboarding Screen 2 (9:16 Optimized) -->
<main class="flex-grow flex flex-col pt-20 pb-safe-area-bottom px-container-padding">
<!-- Hero Illustration Container -->
<div class="relative flex-grow flex flex-col items-center justify-center mb-stack-gap overflow-hidden rounded-xl">
<!-- Atmospheric Glow Background -->
<div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,_rgba(56,222,187,0.1),transparent_70%)]"></div>
<!-- Main Hero Image -->
<div class="relative w-full aspect-square max-w-[320px] parallax-target" id="hero-container">
<img alt="Satellite scanning flooded landscape" class="w-full h-full object-contain rounded-xl" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhC9P6qpQsSerE3Hd0fsVtKR5dNUqbNpKO-XXS6VJA8DxmJYYwF5y7OXO6Xd1dWAzZs6ZxuEJV5gxscyAclqwwJe7OB6Gsu2R9ST33hxgOGyOkDrkxq7aB3WjPI2bU4Vqg4i6c-AecY3Nwwwjx7ATyjdQdxr6Feg5JM_7RAOfg07bLvjjLIJ8K-JK05GNpOLQDdJL3aIsm9BXrTwkOABDE5sxs8HQAky-YrrGdjyK9w5nqL1hwHL585nawLyjozxFELSV9t8_68k1T">
<!-- Overlay Scan Lines (Decorative HUD effect) -->
<div class="scanning-line"></div>
<!-- Floating Intelligence Chips -->
<div class="absolute top-4 left-4 glass-card px-3 py-1.5 rounded-full flex items-center gap-2 animate-bounce transition-all" style="animation-duration: 3s;">
<span class="material-symbols-outlined text-primary-fixed-dim text-body-sm" style="font-variation-settings: 'FILL' 1;">water_damage</span>
<span class="font-label-caps text-label-caps text-primary">LVL 4 RISKS</span>
</div>
<div class="absolute bottom-10 right-2 glass-card px-3 py-1.5 rounded-full flex items-center gap-2 animate-pulse">
<span class="w-2 h-2 rounded-full bg-[#38debb] shadow-[0_0_8px_#38debb]"></span>
<span class="font-label-caps text-label-caps text-primary">LIVE SCAN</span>
</div>
</div>
</div>
<!-- Glassmorphic Description Card -->
<section class="glass-card w-full p-6 rounded-3xl flex flex-col gap-element-gap items-center text-center mb-stack-gap relative">
<!-- Accent detail -->
<div class="absolute top-0 left-1/2 -translate-x-1/2 w-12 h-1 bg-primary/20 rounded-b-full"></div>
<h2 class="font-headline-md text-headline-md text-primary mt-2">Flood Detection</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-[280px]">
                Receive early flood warnings powered by satellite intelligence.
            </p>
</section>
<!-- Footer Actions & Pagination -->
<footer class="flex flex-col items-center gap-stack-gap mb-10">
<!-- Pagination Dots (BottomNavBar logic: 2nd active) -->
<div class="flex items-center justify-center gap-2 h-4">
<div class="bg-outline-variant text-transparent rounded-full w-2 h-2 mx-1 transition-all"></div>
<div class="bg-primary text-on-primary rounded-full w-3 h-3 mx-1 shadow-[0_0_10px_rgba(255,255,255,0.5)]"></div>
<div class="bg-outline-variant text-transparent rounded-full w-2 h-2 mx-1 transition-all"></div>
<div class="bg-outline-variant text-transparent rounded-full w-2 h-2 mx-1 transition-all"></div>
<div class="bg-outline-variant text-transparent rounded-full w-2 h-2 mx-1 transition-all"></div>
</div>
<!-- Primary Action Button -->
<button class="w-full h-14 rounded-2xl accent-gradient cyan-glow flex items-center justify-center gap-2 active:scale-[0.98] transition-transform group">
<span class="font-headline-sm text-headline-sm text-on-primary">Next</span>
<span class="material-symbols-outlined text-on-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
</footer>
</main>
<!-- Bottom Nav Bar (Suppressed for Onboarding as per "The Destination Rule") -->
<script>
        // Micro-interaction: Subtle parallax/tilt for hero image
        const hero = document.getElementById('hero-container');
        document.addEventListener('mousemove', (e) => {
            if (!hero) return;
            const xAxis = (window.innerWidth / 2 - e.pageX) / 45;
            const yAxis = (window.innerHeight / 2 - e.pageY) / 45;
            hero.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });

        // Interactive Button Ripple effect
        document.querySelector('button').addEventListener('click', function(e) {
            let ripple = document.createElement('span');
            ripple.classList.add('absolute', 'bg-white/20', 'rounded-full', 'animate-ping');
            ripple.style.width = '100px';
            ripple.style.height = '100px';
            ripple.style.left = `${e.offsetX - 50}px`;
            ripple.style.top = `${e.offsetY - 50}px`;
            this.appendChild(ripple);
            setTimeout(() => ripple.remove(), 600);
        });
    </script>
</body></html>
